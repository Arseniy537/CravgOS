--lua
--needs luaide-hl
-- luaide-ui - screen and file helpers for luaide (module)
local hl = dofile("/apps/luaide-hl")
local U = {sel = 1, ftop = 1, stop = 1, msg = "Enter: edit  r: run  x: edit+run  c: check  n: new  d: del  k: repl  h: help  q: quit"}
function U.files()
  local r = {}
  for _, n in ipairs(fs.list("/lua") or {}) do if n:sub(-4) == ".lua" then r[#r + 1] = n end end
  table.sort(r)
  return r
end
local function norm(s)
  local t = {}
  for i = 1, #s do
    local b = s:byte(i)
    if b == 9 then t[#t + 1] = "  " elseif b ~= 13 then t[#t + 1] = s:sub(i, i) end
  end
  return table.concat(t)
end
function U.ask(p)
  term.color(15, 1) term.fill(0, 24, 80, 1, " ") term.put(1, 24, p) term.at(2 + #p, 24) term.cursor(true)
  local s = term.readline() term.cursor(false)
  return s
end
function U.draw(fl)
  term.color(7, 0) term.clear()
  term.color(14, 1) term.fill(0, 0, 80, 1, " ") term.put(1, 0, "Lua IDE   /lua   " .. #fl .. " files")
  term.color(8, 0)
  for y = 1, 23 do term.put(19, y, "|") end
  if U.sel < U.ftop then U.ftop = U.sel elseif U.sel >= U.ftop + 22 then U.ftop = U.sel - 21 end
  if U.ftop < 1 then U.ftop = 1 end
  for r = 0, 21 do
    local i = U.ftop + r
    local n = fl[i]
    if not n then break end
    if i == U.sel then term.color(0, 11) else term.color(7, 0) end
    local d = #n > 16 and n:sub(1, 16) or n
    term.put(1, 1 + r, " " .. d .. string.rep(" ", 16 - #d))
  end
  if not fl[U.sel] then
    term.color(8, 0)
    term.put(22, 2, "(no .lua files in /lua - press 'n' to create)")
  else
    local src = fs.read("/lua/" .. fl[U.sel]) or ""
    local ls, p = {}, 1
    while p <= #src do
      local e = src:find("\n", p, true)
      ls[#ls + 1] = src:sub(p, (e or #src + 1) - 1)
      if not e then break end
      p = e + 1
    end
    if #ls == 0 then ls[1] = "" end
    local maxtop = #ls - 21
    if maxtop < 1 then maxtop = 1 end
    if U.stop > maxtop then U.stop = maxtop end
    if U.stop < 1 then U.stop = 1 end
    term.color(14, 1) term.put(62, 0, string.format("L%d/%d", U.stop, #ls))
    if #ls > 22 then term.put(71, 0, "PgUp/Dn") end
    for r = 0, 21 do
      local lno = U.stop + r
      if lno > #ls then break end
      term.color(8, 0) term.put(20, 1 + r, string.format(lno > 999 and "%4d" or "%3d", lno))
      hl(lno > 999 and 25 or 24, 1 + r, norm(ls[lno]), lno > 999 and 54 or 55)
    end
  end
  term.color(14, 0) term.fill(0, 24, 80, 1, " ") term.put(1, 24, tostring(U.msg):sub(1, 78))
end
function U.run(f)
  term.color(7, 0) term.clear() term.cursor(true)
  local ok, e = pcall(dofile, "/lua/" .. f)
  if gfx and gfx.close and not CWM then pcall(gfx.close) end
  term.color(ok and 10 or 12, 0) term.cursor(true)
  term.write("\n-- ", ok and "finished" or tostring(e), " -- press any key")
  term.getkey() term.cursor(false)
  U.msg = (ok and "ran " or "error in ") .. f
end
return U
