--stas-bundle
@@ cravgfm 5929
--lua
--needs cravgwm
--members 
-- cravgfm - file manager in the style of pcmanfm: browse everywhere, change files under /lua. Config: /etc/cravgwm/cravgfm.xml
local M = {}
function M.new(W, args)
  local U, UI = W.u, W.ui
  local root = W.xml.load("/etc/cravgwm/cravgfm.xml") or {a = {}, list = function() return {} end}
  local a = root.a
  local c = {title = "files", class = "cravgfm", w = U.num(a.width, 560), h = U.num(a.height, 380), bg = U.color(a.bg, 0x1e1e2e), fg = U.color(a.fg, 0xdddddd),
    sel = U.color(a.selbg, 0x2a5caa), dir = U.color(a.dircolor, 0x66aaff), path = args ~= "" and args or (a.start or "/"), items = {}, i = 1, top = 0, pw = U.num(a.preview, 200), msg = "", mark = {}}
  local assoc, books = {}, root:list("bookmark")
  for _, e in ipairs(root:list("assoc")) do assoc[e.a.ext or ""] = e.a.command end
  local function join(p, n) if p == "/" then return "/" .. n end return p .. "/" .. n end
  function c:load()
    local l = fs.list(self.path) or {}
    local hid = U.bool(a.hidden, false)
    local d, f = {}, {}
    for _, n in ipairs(l) do
      if hid or n:sub(1, 1) ~= "." then if n:sub(-1) == "/" then d[#d + 1] = n else f[#f + 1] = n end end
    end
    table.sort(d) table.sort(f)
    self.items = {}
    if self.path ~= "/" then self.items[1] = {n = "..", dir = true} end
    for _, n in ipairs(d) do self.items[#self.items + 1] = {n = n:sub(1, -2), dir = true} end
    for _, n in ipairs(f) do local p = join(self.path, n) local t = fs.read(p) self.items[#self.items + 1] = {n = n, size = t and #t or 0} end
    self.i, self.top = math.min(self.i, math.max(#self.items, 1)), 0
    self.title = "files: " .. self.path
    if self.win then self.win.title = self.title self.win.fdirty = true end
  end
  function c:start() self:load() end
  function c:open(it)
    if it.dir then
      if it.n == ".." then local p = self.path:sub(1, (function() local k = #self.path while k > 1 and self.path:sub(k, k) ~= "/" do k = k - 1 end return k end)() - 1) self.path = p == "" and "/" or p
      else self.path = join(self.path, it.n) end
      self.i = 1 self:load()
    else
      local ext = it.n:sub((function() local k = #it.n while k > 0 and it.n:sub(k, k) ~= "." do k = k - 1 end return k + 1 end)())
      local cmd = assoc[ext:lower()]
      if cmd then
        local p = join(self.path, it.n)
        local k = cmd:find("%f", 1, true)
        W.run(k and (cmd:sub(1, k - 1) .. p .. cmd:sub(k + 2)) or (cmd .. " " .. p))
      else self.msg = "no association for ." .. ext end
    end
  end
  local rows = function(self, h) return (h - 52) // 18 end
  function c:draw(s, w, h)
    gfx.fill(0, 0, w, h, self.bg)
    gfx.fill(0, 0, w, 22, self.fg, 20)
    gfx.text(6, 3, U.fit(self.path, w - 12), self.fg)
    local lw = w - self.pw
    local n = rows(self, h)
    if self.i <= self.top then self.top = self.i - 1 elseif self.i > self.top + n then self.top = self.i - n end
    for r = 1, n do
      local it = self.items[self.top + r]
      if it then
        local y = 24 + (r - 1) * 18
        if self.top + r == self.i then gfx.fill(2, y, lw - 4, 18, self.sel) end
        gfx.text(8, y + 1, it.dir and "[" or " ", self.dir) gfx.text(16, y + 1, U.fit(it.n, lw - 110), it.dir and self.dir or self.fg)
        if not it.dir then local sz = tostring(it.size) gfx.text(lw - 8 - #sz * 8, y + 1, sz, self.fg) end
      end
    end
    gfx.fill(lw, 22, 1, h - 22, self.fg, 60)
    local it = self.items[self.i]
    if it and not it.dir then
      local p = join(self.path, it.n)
      if it.n:sub(-4):lower() == ".bmp" then
        local bs = gfx.bmp(p)
        if bs then local iw, ih = gfx.sizeof(bs) local k = math.min((self.pw - 12) * 100 // iw, (h - 60) * 100 // ih, 400) gfx.scale(bs, lw + 6, 28, iw * k // 100, ih * k // 100) gfx.free(bs) end
      else
        local t = fs.read(p) or ""
        local ln, y, pos = 0, 28, 1
        while y < h - 30 and pos <= #t and ln < 40 do
          local e = t:find("\n", pos, true) or #t + 1
          gfx.text(lw + 6, y, U.fit(t:sub(pos, e - 1), self.pw - 10), self.fg)
          pos, y, ln = e + 1, y + 16, ln + 1
        end
      end
    end
    gfx.fill(0, h - 24, w, 24, self.fg, 20)
    gfx.text(6, h - 20, U.fit(self.msg ~= "" and self.msg or "Enter open  Bksp up  F5 reload  Del delete (/lua)  F7 new folder (/lua)", w - 12), self.fg)
  end
  function c:key(k, m)
    local it = self.items[self.i]
    if k == term.UP then self.i = math.max(1, self.i - 1)
    elseif k == term.DOWN then self.i = math.min(#self.items, self.i + 1)
    elseif k == 10 and it then self:open(it)
    elseif k == 8 then self:open({n = "..", dir = true})
    elseif k == term.F1 + 4 then self:load() self.msg = "reloaded"
    elseif k == term.DEL and it and it.n ~= ".." then
      local ok = fs.remove(join(self.path, it.n))
      self.msg = ok and "deleted " .. it.n or "cannot delete (only under /lua)" self:load()
    elseif k == term.F1 + 6 then
      local nm = "folder"
      for i = 1, 99 do if not fs.exists(join(self.path, nm .. i)) then nm = nm .. i break end end
      self.msg = fs.mkdir(join(self.path, nm)) and "created " .. nm or "cannot create (only under /lua)" self:load()
    elseif k >= 49 and k <= 57 and m & 4 ~= 0 and books[k - 48] then self.path = books[k - 48].a.path or "/" self.i = 1 self:load()
    else return false end
    return true
  end
  function c:mouse(ev)
    if ev.t == "wheel" then self.i = U.clamp(self.i + (ev.wheel > 0 and -3 or 3), 1, math.max(#self.items, 1)) return true end
    if ev.t ~= "down" or ev.btn ~= 1 then return false end
    local r = (ev.y - 24) // 18 + 1
    local it = self.items[self.top + r]
    if ev.y >= 24 and it and ev.x < self.w - self.pw then
      local now = os.ms()
      if self.i == self.top + r and self.lc and now - self.lc < 400 then self:open(it) self.lc = nil else self.i = self.top + r self.lc = now end
      return true
    end
    return false
  end
  return c
end
return M

